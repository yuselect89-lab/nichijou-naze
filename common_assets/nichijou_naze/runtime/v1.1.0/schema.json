{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "const": "1.1.0"
    },
    "layout": {
      "enum": [
        "NNZ_LAYOUT_FOOTAGE_01",
        "NNZ_LAYOUT_DIAGRAM_01",
        "NNZ_LAYOUT_FOCUS_01"
      ]
    },
    "durationFrames": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "background": {
      "$ref": "#/$defs/media"
    },
    "title": {
      "type": "string",
      "maxLength": 20
    },
    "character": {
      "$ref": "#/$defs/character"
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "arrows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/arrow"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "crossSection": {
      "$ref": "#/$defs/crossSection"
    },
    "focus": {
      "$ref": "#/$defs/focus"
    },
    "legacyOverlay": {
      "$ref": "#/$defs/legacyOverlay"
    },
    "protectedSubjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rect"
      }
    }
  },
  "required": [
    "id",
    "revision",
    "layout",
    "durationFrames",
    "background"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nnz:scene:1.1.0",
  "$defs": {
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1080
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1920
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 1080
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 1920
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1080
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1920
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "objectPosition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "src"
      ],
      "additionalProperties": false
    },
    "poseCue": {
      "type": "object",
      "properties": {
        "fromFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "pose": {
          "enum": [
            "neutral",
            "talk",
            "point_right",
            "point_left",
            "think",
            "surprise",
            "happy",
            "troubled"
          ]
        }
      },
      "required": [
        "fromFrame",
        "pose"
      ],
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "properties": {
        "side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "height": {
          "type": "number",
          "minimum": 260,
          "maximum": 1150
        },
        "top": {
          "type": "number",
          "minimum": 320,
          "maximum": 1480
        },
        "enterFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "exitFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "transitionFrames": {
          "type": "integer",
          "minimum": 8,
          "maximum": 30
        },
        "entry": {
          "enum": [
            "fade",
            "slide"
          ]
        },
        "idle": {
          "type": "boolean"
        },
        "nodAt": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600
          }
        },
        "poses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/poseCue"
          }
        }
      },
      "required": [
        "poses"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 14
        },
        "anchor": {
          "$ref": "#/$defs/point"
        },
        "box": {
          "$ref": "#/$defs/rect"
        },
        "fromFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "toFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "color": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "text",
        "anchor",
        "box",
        "fromFrame"
      ],
      "additionalProperties": false
    },
    "arrow": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/point"
        },
        "to": {
          "$ref": "#/$defs/point"
        },
        "fromFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "color": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from",
        "to",
        "fromFrame"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18
        },
        "fromFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "enum": [
            "dots",
            "inward",
            "bubbles"
          ]
        },
        "color": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text",
        "fromFrame"
      ],
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "fromFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "toFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "image",
        "fromFrame"
      ],
      "additionalProperties": false
    },
    "crossSection": {
      "type": "object",
      "properties": {
        "outside": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "region": {
          "$ref": "#/$defs/rect"
        },
        "cutLine": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "outside",
        "parts",
        "region"
      ],
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/point"
        },
        "zoom": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 3
        },
        "zoomFromFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "revealFromFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "revealFrames": {
          "type": "integer",
          "minimum": 8,
          "maximum": 90
        },
        "returnFromFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "target",
        "zoom",
        "zoomFromFrame",
        "revealFromFrame",
        "revealFrames"
      ],
      "additionalProperties": false
    },
    "legacyOverlay": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "NNZ_TMP_ARROW_01",
            "NNZ_TMP_COMPARE_01",
            "NNZ_TMP_ZOOM_01"
          ]
        },
        "fromFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "fromFrame",
        "durationFrames",
        "config"
      ],
      "additionalProperties": false
    }
  },
  "description": "Shape schema. validateScene additionally checks cross-field timing, safe zones, pose availability and protected-subject overlap."
}
